#
# X86_64 / Lean's OpenWrt (master) 编译配置
# 版本标识 25.12.2 · IPv4-only · 双主题 + 自定义插件集
# 说明：这里只写"关键开关"，其余由 make defconfig 自动补全
#
# ==== Target: x86_64 (Generic) ====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
# x86/64 下唯一的设备 profile 是 generic，defconfig 会自动选中；
# 若日志显示未选中设备，可追加下面任意一行（新版/旧版符号写法）
# CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
# CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y

# ==== 版本标识 ====
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="OpenWrt"
CONFIG_VERSION_NUMBER="25.12.2"
CONFIG_VERSION_CODE="25.12.2"
CONFIG_VERSION_REPO="https://downloads.openwrt.org/releases/25.12.2"

# ==== IPv4 单栈（运行时禁用；内核 CONFIG_IPV6 必须保持 y） ====
# 不要写 "# CONFIG_IPV6 is not set"：Linux 6.18 的 kmod-nft-core 在 FILES 里
# 无条件包含 net/ipv6/netfilter/nft_reject_ipv6.ko，关掉内核 IPv6 会让该 .ko
# 不生成，打包时报 "ERROR: module ... is missing" 并让整个编译失败。
# 实际 IPv4 单栈由 diy-part2.sh 实现：
#   - config_generate 不生成 wan6 / ip6assign / IPv6 DNS
#   - /etc/sysctl.d/99-ipv4-only.conf 全局 disable_ipv6
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_6in4 is not set
# CONFIG_PACKAGE_6to4 is not set

# ==== LuCI 基础 ====
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_PACKAGE_luci-theme-bootstrap is not set

# ==== 主题（Argon 为默认，Vantage / Aurora 同时安装） ====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-theme-aurora=y
# CONFIG_PACKAGE_luci-app-vantage is not set

# ==== 用户指定插件 · 第一组 ====
CONFIG_PACKAGE_luci-app-run=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_quickfile=y
CONFIG_PACKAGE_luci-app-partexp=y

# ==== 用户指定插件 · 第二组 ====
# PassWall2（feed 源见 feeds.conf.default）
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
# Clashoo（上游 DEPENDS 在 Lean 25.12 下解析失败，已由 diy-part2.sh 精简；
# 这里把运行时需要的工具显式选中，保证功能完整）
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_luci-app-clashoo=y
CONFIG_PACKAGE_luci-i18n-clashoo-zh-cn=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
# Docker
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_ttyd=y
# DiskMan
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y

# ==== 常用基础组件 ====
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-tun=y
